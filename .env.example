# Environment Configuration (development | testing | production)
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security & Secrets (CHANGE IN PRODUCTION)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_predictive_maintenance

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Swagger / Flasgger Documentation
SWAGGER_URL=/api/docs
